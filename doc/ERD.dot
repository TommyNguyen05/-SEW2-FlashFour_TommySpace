digraph ERD {
  graph [rankdir=LR, nodesep=0.4, ranksep=0.6];
  node [shape=record, fontsize=10];

  Users [label="{users|id PK; email; display_name; password_digest; timestamps}"];
  Decks [label="{decks|id PK; owner_id FK→users; title; description; is_public; timestamps}"];
  DeckCollaborators [label="{deck_collaborators|id PK; deck_id FK→decks; user_id FK→users; role; timestamps}"];
  Cards [label="{cards|id PK; deck_id FK→decks; card_type; front_text; back_text; extras(jsonb); suspended; timestamps}"];
  CardProgresses [label="{card_progresses|id PK; user_id FK→users; card_id FK→cards; repetitions; lapses; interval_days; ease_factor; due_at; state; timestamps}"];
  Reviews [label="{reviews|id PK; user_id FK→users; card_id FK→cards; rating; time_taken_ms; scheduled_interval_days; new_interval_days; new_ease_factor; reviewed_at; timestamps}"];
  Tags [label="{tags|id PK; name; timestamps}"];
  Taggings [label="{taggings|id PK; tag_id FK→tags; card_id FK→cards; timestamps}"];

  Users -> Decks [label="1 owns *", fontsize=9];
  Users -> DeckCollaborators [label="1 has *", fontsize=9];
  Decks -> DeckCollaborators [label="1 has *", fontsize=9];

  Decks -> Cards [label="1 has *", fontsize=9];

  Users -> CardProgresses [label="1 has *", fontsize=9];
  Cards -> CardProgresses [label="1 has *", fontsize=9];

  Users -> Reviews [label="1 has *", fontsize=9];
  Cards -> Reviews [label="1 has *", fontsize=9];

  Tags -> Taggings [label="1 has *", fontsize=9];
  Cards -> Taggings [label="1 has *", fontsize=9];
}
