<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "learning_sessions", "data-turbo-track": "reload" %>
<% end %>

<div class="completion-container">
  <div class="completion-card">
    <h1 class="completion-title">Learning Completed! 🎉</h1>
    
    <div class="statistics">
      <h2>Session Statistics</h2>
      
      <% if @mastered_percentage > 0 %>
        <div class="stat-item">
          <div class="stat-bar mastered-bar" style="width: <%= @mastered_percentage %>%">
            <span class="stat-label">Mastered: <%= @mastered_percentage %>%</span>
          </div>
        </div>
      <% end %>

      <% if @still_learning_percentage > 0 %>
        <div class="stat-item">
          <div class="stat-bar still-learning-bar" style="width: <%= @still_learning_percentage %>%">
            <span class="stat-label">Still Learning: <%= @still_learning_percentage %>%</span>
          </div>
        </div>
      <% end %>

      <% if @unfamiliar_percentage > 0 %>
        <div class="stat-item">
          <div class="stat-bar unfamiliar-bar" style="width: <%= @unfamiliar_percentage %>%">
            <span class="stat-label">Unfamiliar: <%= @unfamiliar_percentage %>%</span>
          </div>
        </div>
      <% end %>

      <div class="stat-summary">
        <p><strong>Total cards reviewed:</strong> <%= @total %></p>
        <p><strong>Mastered:</strong> <%= @mastered_count %> (<%= @mastered_percentage %>%)</p>
        <p><strong>Still Learning:</strong> <%= @still_learning_count %> (<%= @still_learning_percentage %>%)</p>
        <p><strong>Unfamiliar:</strong> <%= @unfamiliar_count %> (<%= @unfamiliar_percentage %>%)</p>
      </div>
    </div>

    <div class="completion-actions">
      <%= form_with url: restart_deck_learning_session_path(@deck), method: :post, local: true do |f| %>
        <%= button_tag 'Learn again?', type: 'submit', class: 'button primary' %>
      <% end %>
      <%= link_to "Back to Deck", @deck, class: "button" %>
    </div>
  </div>
</div>
