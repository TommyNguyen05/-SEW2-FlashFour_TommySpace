<!DOCTYPE html>
<html>
  <head>
    <title>RubyOnRailsProject</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= yield :stylesheets %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="main-header">
      <div class="header-content">
        <div class="logo">
          FlashFour
        </div>
        <nav class="user-nav">
          <% if user_signed_in? %>
            <span class="user-name">Hello, <%= current_user.display_name %></span>
            <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "header-button" %>
          <% else %>
            <%= link_to "Log in", new_user_session_path, class: "header-button" %>
            <%= link_to "Sign up", new_user_registration_path, class: "header-button" %>
          <% end %>
        </nav>
      </div>
    </header>

    <%# --- WRAP THE YIELD IN A 'main' TAG --- %>
    <main class="main-content">
      <%= yield %>
    </main>
    
  </body>
</html>