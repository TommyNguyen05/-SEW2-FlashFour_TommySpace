<!DOCTYPE html>
<html>
  <head>
    <title>RubyOnRailsProject</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= yield :stylesheets %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="main-header">
      <div class="header-content">
        <div class="logo">
          FlashFour
        </div>
        <nav class="user-nav">
          <% if user_signed_in? %>
            <div class="user-dropdown" data-controller="dropdown">
              <button class="dropdown-toggle" data-dropdown-target="toggle" data-action="click->dropdown#toggle">
                <%= current_user.display_name %>
                <span class="dropdown-arrow">▼</span>
              </button>
              <div class="dropdown-menu" data-dropdown-target="menu">
                <%= link_to "Decks", root_path, class: "dropdown-item" %>
                <%= link_to "Progress", progress_path, class: "dropdown-item" %>
                <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "dropdown-item logout-button" %>
              </div>
            </div>
          <% else %>
            <%= link_to "Log in", new_user_session_path, class: "header-button" %>
            <%= link_to "Sign up", new_user_registration_path, class: "header-button" %>
          <% end %>
        </nav>
      </div>
    </header>

    <%# --- WRAP THE YIELD IN A 'main' TAG --- %>
    <main class="main-content">
      <%= yield %>
    </main>
    
  </body>
</html>