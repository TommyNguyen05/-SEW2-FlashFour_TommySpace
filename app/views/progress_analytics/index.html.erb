<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <h1 class="mb-4">
        <i class="bi bi-graph-up"></i> Progress Analytics
      </h1>
    </div>
  </div>

  <!-- Overall Statistics Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title text-muted">Cards Studied</h5>
          <h2 class="mb-0"><%= @total_cards_studied %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title text-muted">Total Reviews</h5>
          <h2 class="mb-0"><%= @total_reviews %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title text-muted">Study Time</h5>
          <h2 class="mb-0"><%= @total_study_time %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title text-muted">Study Streak</h5>
          <h2 class="mb-0"><%= @study_streak %> days</h2>
        </div>
      </div>
    </div>
  </div>

  <!-- Cards by State -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Cards by State</h5>
        </div>
        <div class="card-body">
          <div class="row text-center">
            <div class="col-3">
              <div class="p-3 border rounded">
                <h6 class="text-muted">New</h6>
                <h3 class="text-primary"><%= @new_cards %></h3>
              </div>
            </div>
            <div class="col-3">
              <div class="p-3 border rounded">
                <h6 class="text-muted">Learning</h6>
                <h3 class="text-warning"><%= @learning_cards %></h3>
              </div>
            </div>
            <div class="col-3">
              <div class="p-3 border rounded">
                <h6 class="text-muted">Review</h6>
                <h3 class="text-success"><%= @review_cards %></h3>
              </div>
            </div>
            <div class="col-3">
              <div class="p-3 border rounded">
                <h6 class="text-muted">Relearning</h6>
                <h3 class="text-danger"><%= @relearning_cards %></h3>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Reviews Over Time Chart -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Reviews - Last 7 Days</h5>
        </div>
        <div class="card-body">
          <% if @reviews_by_day.sum { |d| d[:count] } > 0 %>
            <div class="d-flex align-items-end" style="height: 200px;">
              <% max_count = @reviews_by_day.map { |d| d[:count] }.max %>
              <% @reviews_by_day.each do |day| %>
                <div class="flex-fill text-center">
                  <% bar_height = max_count > 0 ? ((day[:count].to_f / max_count) * 100).round : 0 %>
                  <div class="d-flex flex-column align-items-center justify-content-end" style="height: 180px;">
                    <small class="mb-1"><strong><%= day[:count] %></strong></small>
                    <div class="bg-primary rounded-top" style="width: 80%; height: <%= bar_height %>%; min-height: <%= day[:count] > 0 ? '5px' : '0' %>;"></div>
                  </div>
                  <small class="text-muted"><%= day[:date] %></small>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted text-center mb-0">No reviews in the last 7 days</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Performance Stats -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Performance</h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <div class="d-flex justify-content-between mb-1">
              <span>Average Rating</span>
              <strong><%= number_with_precision(@average_rating, precision: 2) %> / 4.0</strong>
            </div>
            <div class="progress" style="height: 20px;">
              <% rating_percentage = (@average_rating / 4.0 * 100).round %>
              <div class="progress-bar bg-success" role="progressbar" style="width: <%= rating_percentage %>%">
                <%= rating_percentage %>%
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Reviews -->
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Recent Reviews</h5>
        </div>
        <div class="card-body">
          <% if @recent_reviews.any? %>
            <div class="list-group list-group-flush">
              <% @recent_reviews.first(5).each do |review| %>
                <div class="list-group-item px-0 py-2">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <small class="text-muted"><%= review.card.deck.title %></small>
                      <div class="text-truncate" style="max-width: 250px;">
                        <%= review.card.front_text %>
                      </div>
                    </div>
                    <div class="text-end">
                      <% rating_stars = '⭐' * review.rating %>
                      <span class="badge bg-light text-dark"><%= rating_stars %></span>
                      <br>
                      <small class="text-muted"><%= time_ago_in_words(review.reviewed_at) %> ago</small>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted mb-0">No reviews yet</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Deck Statistics -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Deck Progress</h5>
        </div>
        <div class="card-body">
          <% if @deck_stats.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Deck</th>
                    <th class="text-center">Total Cards</th>
                    <th class="text-center">Studied</th>
                    <th class="text-center">Mastered</th>
                    <th class="text-center">Learning</th>
                    <th class="text-center">New</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% @deck_stats.each do |stats| %>
                    <tr>
                      <td><%= stats[:deck].title %></td>
                      <td class="text-center"><%= stats[:total_cards] %></td>
                      <td class="text-center"><%= stats[:cards_studied] %></td>
                      <td class="text-center">
                        <span class="badge bg-success"><%= stats[:mastered] %></span>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-warning"><%= stats[:learning] %></span>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-primary"><%= stats[:new] %></span>
                      </td>
                      <td class="text-end">
                        <%= link_to 'View Details', deck_progress_analytics_path(stats[:deck]), class: 'btn btn-sm btn-outline-primary' %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted mb-0">No decks available</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
