<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to 'Progress Analytics', progress_analytics_path %></li>
          <li class="breadcrumb-item active" aria-current="page"><%= @deck.title %></li>
        </ol>
      </nav>
      
      <h1 class="mb-4">
        <i class="bi bi-graph-up"></i> <%= @deck.title %> - Analytics
      </h1>
    </div>
  </div>

  <!-- Deck Statistics Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title text-muted">Total Cards</h5>
          <h2 class="mb-0"><%= @total_cards %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title text-muted">Cards Studied</h5>
          <h2 class="mb-0"><%= @cards_studied %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title text-muted">Total Reviews</h5>
          <h2 class="mb-0"><%= @total_reviews %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title text-muted">Study Time</h5>
          <h2 class="mb-0"><%= @total_study_time %></h2>
        </div>
      </div>
    </div>
  </div>

  <!-- Cards by State -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Card Progress</h5>
        </div>
        <div class="card-body">
          <div class="row text-center">
            <div class="col-3">
              <div class="p-3 border rounded">
                <h6 class="text-muted">New</h6>
                <h3 class="text-primary"><%= @new_cards %></h3>
                <% if @total_cards > 0 %>
                  <small class="text-muted"><%= number_to_percentage((@new_cards.to_f / @total_cards) * 100, precision: 0) %></small>
                <% end %>
              </div>
            </div>
            <div class="col-3">
              <div class="p-3 border rounded">
                <h6 class="text-muted">Learning</h6>
                <h3 class="text-warning"><%= @learning_cards %></h3>
                <% if @total_cards > 0 %>
                  <small class="text-muted"><%= number_to_percentage((@learning_cards.to_f / @total_cards) * 100, precision: 0) %></small>
                <% end %>
              </div>
            </div>
            <div class="col-3">
              <div class="p-3 border rounded">
                <h6 class="text-muted">Mastered</h6>
                <h3 class="text-success"><%= @review_cards %></h3>
                <% if @total_cards > 0 %>
                  <small class="text-muted"><%= number_to_percentage((@review_cards.to_f / @total_cards) * 100, precision: 0) %></small>
                <% end %>
              </div>
            </div>
            <div class="col-3">
              <div class="p-3 border rounded">
                <h6 class="text-muted">Relearning</h6>
                <h3 class="text-danger"><%= @relearning_cards %></h3>
                <% if @total_cards > 0 %>
                  <small class="text-muted"><%= number_to_percentage((@relearning_cards.to_f / @total_cards) * 100, precision: 0) %></small>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Progress Bar -->
          <div class="mt-4">
            <h6 class="text-muted mb-2">Overall Progress</h6>
            <div class="progress" style="height: 30px;">
              <% mastered_pct = @total_cards > 0 ? (@review_cards.to_f / @total_cards * 100).round : 0 %>
              <% learning_pct = @total_cards > 0 ? (@learning_cards.to_f / @total_cards * 100).round : 0 %>
              <% new_pct = @total_cards > 0 ? (@new_cards.to_f / @total_cards * 100).round : 0 %>
              <% relearning_pct = @total_cards > 0 ? (@relearning_cards.to_f / @total_cards * 100).round : 0 %>
              
              <div class="progress-bar bg-success" role="progressbar" style="width: <%= mastered_pct %>%" title="Mastered">
                <%= mastered_pct > 5 ? "#{mastered_pct}%" : "" %>
              </div>
              <div class="progress-bar bg-warning" role="progressbar" style="width: <%= learning_pct %>%" title="Learning">
                <%= learning_pct > 5 ? "#{learning_pct}%" : "" %>
              </div>
              <div class="progress-bar bg-danger" role="progressbar" style="width: <%= relearning_pct %>%" title="Relearning">
                <%= relearning_pct > 5 ? "#{relearning_pct}%" : "" %>
              </div>
              <div class="progress-bar bg-primary" role="progressbar" style="width: <%= new_pct %>%" title="New">
                <%= new_pct > 5 ? "#{new_pct}%" : "" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Reviews Over Time -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Reviews - Last 7 Days</h5>
        </div>
        <div class="card-body">
          <% if @reviews_by_day.sum { |d| d[:count] } > 0 %>
            <div class="d-flex align-items-end" style="height: 200px;">
              <% max_count = @reviews_by_day.map { |d| d[:count] }.max %>
              <% @reviews_by_day.each do |day| %>
                <div class="flex-fill text-center">
                  <% bar_height = max_count > 0 ? ((day[:count].to_f / max_count) * 100).round : 0 %>
                  <div class="d-flex flex-column align-items-center justify-content-end" style="height: 180px;">
                    <small class="mb-1"><strong><%= day[:count] %></strong></small>
                    <div class="bg-primary rounded-top" style="width: 80%; height: <%= bar_height %>%; min-height: <%= day[:count] > 0 ? '5px' : '0' %>;"></div>
                  </div>
                  <small class="text-muted"><%= day[:date] %></small>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted text-center mb-0">No reviews in the last 7 days</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Performance and Recent Reviews -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Performance</h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <div class="d-flex justify-content-between mb-1">
              <span>Average Rating</span>
              <strong><%= number_with_precision(@average_rating, precision: 2) %> / 4.0</strong>
            </div>
            <div class="progress" style="height: 20px;">
              <% rating_percentage = (@average_rating / 4.0 * 100).round %>
              <div class="progress-bar bg-success" role="progressbar" style="width: <%= rating_percentage %>%">
                <%= rating_percentage %>%
              </div>
            </div>
          </div>
          
          <div class="mt-3">
            <div class="d-flex justify-content-between mb-1">
              <span>Completion Rate</span>
              <% completion_rate = @total_cards > 0 ? ((@cards_studied.to_f / @total_cards) * 100).round : 0 %>
              <strong><%= completion_rate %>%</strong>
            </div>
            <div class="progress" style="height: 20px;">
              <div class="progress-bar bg-info" role="progressbar" style="width: <%= completion_rate %>%">
                <%= completion_rate %>%
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Recent Reviews</h5>
        </div>
        <div class="card-body">
          <% if @recent_reviews.any? %>
            <div class="list-group list-group-flush">
              <% @recent_reviews.first(5).each do |review| %>
                <div class="list-group-item px-0 py-2">
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="text-truncate" style="max-width: 250px;">
                      <%= review.card.front_text %>
                    </div>
                    <div class="text-end">
                      <% rating_stars = '⭐' * review.rating %>
                      <span class="badge bg-light text-dark"><%= rating_stars %></span>
                      <br>
                      <small class="text-muted"><%= time_ago_in_words(review.reviewed_at) %> ago</small>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted mb-0">No reviews yet</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Back Button -->
  <div class="row">
    <div class="col-12">
      <%= link_to 'Back to All Analytics', progress_analytics_path, class: 'btn btn-secondary' %>
      <%= link_to 'View Deck', @deck, class: 'btn btn-primary' %>
    </div>
  </div>
</div>
