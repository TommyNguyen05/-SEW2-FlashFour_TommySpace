<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "learning_sessions", "data-turbo-track": "reload" %>
<% end %>

<div class="learning-session-container">
  <%= link_to "← Back to Deck", deck_path(@deck), class: "back-link" %>
  
  <div class="session-header">
    <h1>Quiz: <%= @deck.title %></h1>
    <div class="progress-bar">
      <div class="progress-fill" style="width: <%= ((@current_number - 1).to_f / @total_cards * 100) %>%"></div>
    </div>
    <p class="progress-text">Question <%= @current_number %> of <%= @total_cards %></p>
  </div>

  <div class="card-display">
    <div class="quiz-question">
      <h2>Question</h2>
      <div class="card-content">
        <%= @current_card.front_text %>
      </div>
    </div>

    <div class="quiz-answers">
      <h3>Choose the correct answer:</h3>
      <%= form_with url: answer_deck_quiz_path(@deck), method: :post, class: "quiz-form" do |f| %>
        <div class="answer-options">
          <% @answer_options.each_with_index do |option, index| %>
            <label class="answer-option">
              <%= f.radio_button :answer, option, id: "answer_#{index}" %>
              <span class="answer-label"><%= option %></span>
            </label>
          <% end %>
        </div>
        
        <div class="quiz-actions">
          <%= f.submit "Submit Answer", class: "button primary large" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    // Add click handling for answer options
    document.querySelectorAll('.answer-option').forEach(option => {
      option.addEventListener('click', function() {
        document.querySelectorAll('.answer-option').forEach(opt => {
          opt.classList.remove('selected');
        });
        this.classList.add('selected');
      });
    });
  });
</script>
