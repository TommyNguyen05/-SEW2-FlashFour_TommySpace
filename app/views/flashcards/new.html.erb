<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "decks", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "flashcards", "data-turbo-track": "reload" %>
<% end %>

<div class="center-card">
  <h2>Add a Card</h2>

  <%= form_with model: [@deck, @flashcard], local: true do |f| %>
    <div class="field">
      <%= f.label :front_text, "Front of card (Term)" %>
      <%= f.text_area :front_text, rows: 4, required: true %>
    </div>

    <div class="field">
      <%= f.label :back_text, "Back of card (Translation/Answer)" %>
      <%= f.text_area :back_text, rows: 4 %>
    </div>

    <div class="actions">
      <%= f.submit "Create and add another", name: "commit", class: "button" %>
      <%= f.submit "Done", name: "commit", class: "button primary" %>
      <%= link_to "Cancel", deck_path(@deck), class: "button" %>
    </div>
  <% end %>
</div>