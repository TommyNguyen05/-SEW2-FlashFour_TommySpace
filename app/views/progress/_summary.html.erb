<section class="analytics-section analytics-summary">
  <h2>Overview</h2>
  <div class="analytics-grid">
    <div class="analytics-card">
      <div class="value"><%= total_cards || 0 %></div>
      <div class="label">Total cards</div>
    </div>

    <div class="analytics-card">
      <div class="value"><%= reviewed_today || 0 %></div>
      <div class="label">Reviewed today</div>
    </div>

    <div class="analytics-card">
      <div class="value"><%= due_cards || 0 %></div>
      <div class="label">Due now</div>
    </div>

    <div class="analytics-card">
      <div class="value">
        <%= accuracy.present? ? "#{accuracy}%" : "—" %>
      </div>
      <div class="label">Accuracy</div>
    </div>

    <div class="analytics-card">
      <div class="value">
        <%= streak_days.present? ? "#{streak_days} day#{'s' unless streak_days == 1}" : "0 days" %>
      </div>
      <div class="label">Streak</div>
    </div>
  </div>
</section>
