<%= stylesheet_link_tag 'progress', media: 'all', 'data-turbolinks-track': 'reload' %>

<div class="progress-analytics">

  <%= render "summary",
      total_cards: @total_cards,
      reviewed_today: @reviews_today,
      due_cards: @due_now,
      accuracy: @accuracy,
      streak_days: @streak_days %>

  <%= render "deck_breakdown",
      per_deck_stats: @per_deck_stats %>

  <%= render "activity_chart",
      review_activity: @review_activity %>
</div>