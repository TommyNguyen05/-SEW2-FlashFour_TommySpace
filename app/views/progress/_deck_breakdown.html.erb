<section class="analytics-section analytics-decks">
  <h2>By Deck</h2>

  <% if per_deck_stats.present? && per_deck_stats.any? %>
    <table class="analytics-table">
      <thead>
        <tr>
          <th>Deck Name</th>
          <th>Total Cards</th>
          <th>Due Now</th>
          <th>Reviewed Today</th>
          <th>Accuracy</th>
        </tr>
      </thead>
      <tbody>
        <% per_deck_stats.each do |deck| %>
          <tr>
            <td><strong><%= deck[:name] %></strong></td>
            <td><%= deck[:total] || 0 %></td>
            <td><%= deck[:due] || 0 %></td>
            <td><%= deck[:reviewed_today] || 0 %></td>
            <td>
              <% acc = deck[:accuracy] %>
              <%= acc.present? ? "#{acc}%" : "—" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty-state-message">No deck data yet. Start reviewing to see per-deck analytics.</p>
  <% end %>
</section>
