<section class="analytics-section analytics-decks">
  <h2>By deck</h2>

  <% if per_deck_stats.present? && per_deck_stats.any? %>
    <table class="analytics-table">
      <thead>
        <tr>
          <th>Deck</th>
          <th>Total</th>
          <th>Due</th>
          <th>Reviewed today</th>
          <th>Accuracy</th>
        </tr>
      </thead>
      <tbody>
        <% per_deck_stats.each do |deck| %>
          <tr>
            <td><%= deck[:name] %></td>
            <td><%= deck[:total] || 0 %></td>
            <td><%= deck[:due] || 0 %></td>
            <td><%= deck[:reviewed_today] || 0 %></td>
            <td>
              <% acc = deck[:accuracy] %>
              <%= acc.present? ? "#{acc}%" : "—" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No deck data yet. Start reviewing to see per-deck analytics.</p>
  <% end %>
</section>
