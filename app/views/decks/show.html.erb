<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "decks", "data-turbo-track": "reload" %>
<% end %>

<div class="deck-detail-container">
  <%= link_to "← Back to All Decks", decks_path, class: "back-link" %>
  
  <div class="deck-header">
    <div class="deck-info">
      <h1><%= @deck.title %></h1>
      <p class="deck-description"><%= @deck.description %></p>
      <div class="deck-metadata">
        <span class="metadata-item">
          <strong>Cards:</strong> <%= @deck.flashcards.count %>
        </span>
        <span class="metadata-item">
          <strong>Last Updated:</strong> <%= @deck.updated_at.strftime("%B %d, %Y") %>
        </span>
      </div>
    </div>
  </div>

  <div class="deck-actions">
    <div class="primary-actions">
      <%= link_to "Start Learning", start_deck_learning_session_path(@deck), class: "button primary large" %>
      <%= link_to "Take a Quiz", start_deck_quiz_path(@deck), class: "button secondary large" %>
    </div>
    
    <div class="secondary-actions">
      <%= link_to "Add Card", new_deck_flashcard_path(@deck), class: "button" %>
      <%= link_to "Rename Deck", edit_deck_path(@deck), class: "button" %>
      <%= link_to "Export", export_deck_path(@deck), class: "button" %>
    </div>
  </div>

  <% if @deck.flashcards.any? %>
    <div class="flashcards-section">
      <h2>Flashcards Overview</h2>
      <div class="flashcards-list">
        <% @deck.flashcards.each do |card| %>
          <div class="flashcard-item">
            <div class="flashcard-front">
              <span class="card-label">Front:</span>
              <span class="card-text"><%= truncate(card.front_text, length: 80) %></span>
            </div>
            <div class="flashcard-back">
              <span class="card-label">Back:</span>
              <span class="card-text"><%= truncate(card.back_text, length: 80) %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="empty-state">
      <p>This deck doesn't have any flashcards yet.</p>
      <%= link_to "Add your first card", new_deck_flashcard_path(@deck), class: "button primary" %>
    </div>
  <% end %>
</div>