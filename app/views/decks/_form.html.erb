<div class="center-card">
  <h2><%= @deck.new_record? ? "Create new Deck" : "Edit Deck" %></h2>

  <%= form_with model: @deck, local: true do |f| %>
    <div class="field">
      <%= f.label :title, "Name your Deck" %>
      <%= f.text_field :title, required: true %>
    </div>

    <div class="field">
      <%= f.label :description %>
      <%= f.text_area :description, rows: 3 %>
    </div>

    <div class="field">
      <%= f.label :is_public, "Make deck public?" %>
      <%= f.check_box :is_public %>
    </div>

    <div class="actions">
      <%= f.submit (@deck.new_record? ? "Create" : "Update"), class: "button primary" %>
      <%= link_to "Cancel", (@deck.new_record? ? decks_path : deck_path(@deck)), class: "button" %>
    </div>
  <% end %>
</div>